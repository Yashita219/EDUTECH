# Import libraries
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler

# Load dataset
df = pd.read_csv("Titanic-Dataset.csv")

# Display first 5 rows
print("First 5 Rows:")
print(df.head())

# Check dataset information
print("\nDataset Info:")
print(df.info())

# Check missing values
print("\nMissing Values:")
print(df.isnull().sum())

# -------------------------------
# Handling Missing Values
# -------------------------------

# Fill Age missing values with median
df['Age'].fillna(df['Age'].median(), inplace=True)

# Fill Embarked missing values with mode
df['Embarked'].fillna(df['Embarked'].mode()[0], inplace=True)

# Fill Fare missing values with median if any
df['Fare'].fillna(df['Fare'].median(), inplace=True)

# Drop Cabin column because it contains many missing values
if 'Cabin' in df.columns:
    df.drop(columns=['Cabin'], inplace=True)

# -------------------------------
# Remove Duplicate Records
# -------------------------------

print("\nDuplicates Before Removal:", df.duplicated().sum())

df.drop_duplicates(inplace=True)

print("Duplicates After Removal:", df.duplicated().sum())

# -------------------------------
# Convert Data Types
# -------------------------------

# Convert Survived and Pclass to category type
df['Survived'] = df['Survived'].astype('category')
df['Pclass'] = df['Pclass'].astype('category')

# -------------------------------
# Handle Outliers using IQR Method
# -------------------------------

numerical_cols = ['Age', 'Fare']

for col in numerical_cols:
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1

    lower = Q1 - 1.5 * IQR
    upper = Q3 + 1.5 * IQR

    df = df[(df[col] >= lower) & (df[col] <= upper)]

print("\nOutliers Removed")

# -------------------------------
# Feature Scaling / Normalization
# -------------------------------

scaler = StandardScaler()

df[['Age', 'Fare']] = scaler.fit_transform(df[['Age', 'Fare']])

print("\nScaled Numerical Features")

# -------------------------------
# Final Cleaned Dataset
# -------------------------------

print("\nCleaned Dataset Preview:")
print(df.head())

# Save cleaned dataset
df.to_csv("Cleaned_Titanic_Dataset.csv", index=False)

print("\nCleaned dataset saved successfully!")
